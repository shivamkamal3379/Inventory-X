auth_tokens [icon: key, color: red] {
  id string pk
  user_id string fk
  token string
  expires_at timestamp
  created_at timestamp
}
t_Item[icon: package , color:  yellow]{
  itemId number pk 
  name string 
  description string 
  qty number
  created_at timestamp
  size string 
  weight string 
  ManufactureYr datetime 
  materialType string 
  model string 
  additionalParam1 string 

}
t_AvaiableStock[icon: boxes , color :purple]{
  itemId number pk // Make sure It Do Not change
  //description string 
  qty number fk  // reference from itemMaster // Make sure It Do Not change
  RentedOutQty number 
  availableQty number 

}
t_Agents[icon: person , color: red]{
  agentId number
  AgentName number 
  mobile number 
  aadhar number 
  email string 
  // ActiveClients number 
  // status enum 
  // this can be multiple names according to his performance 
}

t_party [icon: users, color: blue] {
  id string pk
  name string
  mobile number
  aadhaar number 
  secondaryMobile number
  email string
  address string
  agentId number
  agentName string
  // current_balance decimal
  // active_items int
  siteAddress string
  status enum  // active, inactive, payment_due, default, closed
  dateCreated timestamp
}

RentalPrice [icon: money , color: orange]{
  itemId number pk 
  itemName string 
  rent number
  rentFrequency string 
  // availableQty number  

}

rentoutTxn[icon: list , color: orange]{
  partyId string pk 
  contractId number 
  PartyName string  
  agentId number 
  AgentName string // self or Agent applicable 
  Item string 
  itemQty number 
  // multiple rows to be entered in DB  
  TxnDate timestamp 
}
returnTxn[icon: package , color: orange]{
  partyId string pk 
  contractId number 
  PartyName string  
  agentId number 
  AgentName string // self or Agent applicable 
  Item string 
  itemQty number 
  // multiple rows to be entered in DB  
  TxnDate timestamp 
}


// Relationships building 
t_party.agentId > t_Agents.agentId

t_AvaiableStock.itemId - t_Item.itemId 

RentalPrice.itemId -  t_Item.itemId 

rentoutTxn.partyId > t_party.id 

rentoutTxn.agentId > t_Agents.agentId 


