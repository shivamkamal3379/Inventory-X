# ============================================================================
# Inventory X — deployment configuration
#
#   cp .env.example .env
#
# .env is gitignored. Never commit real secrets.
# ============================================================================

# --- Environment ------------------------------------------------------------
# development | staging | production
# Outside development the app refuses to start with a default SECRET_KEY,
# with CORS_ORIGINS="*", with DEBUG=true, or on SQLite. That is deliberate.
ENVIRONMENT=production

# --- Database ---------------------------------------------------------------
POSTGRES_USER=inventoryx
POSTGRES_DB=inventoryx
# REQUIRED. Generate one:  openssl rand -base64 24
POSTGRES_PASSWORD=

# --- Security ---------------------------------------------------------------
# REQUIRED, at least 32 characters. Generate one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing this invalidates every issued login token.
SECRET_KEY=

# How long a login lasts, in minutes. 720 = 12 hours.
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Leave false in production. If true, anyone who can reach the API can create
# themselves an account. Use FIRST_ADMIN_* below to seed the first login instead.
ALLOW_REGISTRATION=false

# Created automatically on first boot if it does not already exist.
# Set a strong password, log in, then change it via /auth/change-password.
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=

# --- Web --------------------------------------------------------------------
# Host port the site is published on.
WEB_PORT=8080

# Origins allowed to call the API from a browser. Comma-separated, no spaces.
# With the bundled nginx the frontend is same-origin, so this only matters if
# you serve the UI from somewhere else. "*" is rejected in production.
CORS_ORIGINS=http://localhost:8080

# Where the browser reaches the API. Baked in at build time.
# Leave as /api when using the bundled nginx.
VITE_API_BASE_URL=/api

# --- Runtime ----------------------------------------------------------------
# Gunicorn worker processes. Rule of thumb: (2 x CPU cores) + 1.
# Note: the login rate limiter counts per worker, so N workers means the
# effective limit is N x LOGIN_RATE_LIMIT_ATTEMPTS. See docs/DEPLOYMENT.md.
WEB_CONCURRENCY=2

LOG_LEVEL=INFO
LOG_JSON=true
